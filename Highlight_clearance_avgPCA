# make msns
Create_MSn <- function(df, sample, add_markers =NULL) {
  cols <- colnames(df)[str_detect(colnames(df), paste0("rowname|", sample))]
  if(!is.null(add_markers)){
  print("Adding Markers")
  x <- readMSnSet2(file = df %>% dplyr::select(all_of(cols)),
                       ecol = c(2:length(cols)),
                       fnames = "rowname") %>% 
  MSnbase::normalize(method="sum") |> 
  MSnbase::filterNA() |>
  pRoloc::addMarkers(add_markers, verbose=F)
  } else {
    print("Using no Markers")
    x <- readMSnSet2(file = df %>% dplyr::select(all_of(cols)),
                       ecol = c(2:length(cols)),
                       fnames = "rowname") %>% 
  MSnbase::normalize(method="sum") |> 
  MSnbase::filterNA()
  }
  return(x)}

# This will store one comp_list per dataset
all_comp_lists <- list()
conditions <- c("C", "T")

# Loop over each dataset in cleaned_averages
for (df_name in names(cleaned_averages)) {
  markers_df <- cleaned_averages[[df_name]]
  
  msn_list <- list()  # To collect MSnSets for this dataset
  
  for (i in conditions) {
    cols <- colnames(markers_df)[str_detect(colnames(markers_df), i)]
    df <- markers_df %>% dplyr::select(rowname, all_of(cols)) %>% na.omit()
    samples <- unique(gsub("hr_.*", "hr", cols))
    
    for (j in samples) {
      cols2 <- colnames(df)[str_detect(colnames(df), j)]
      msn <- Create_MSn(df %>% dplyr::select(rowname, all_of(cols2)), 
                        sample = j, add_markers = markers)
      
      # Store with name like "C1_1hr" or "T1_4hr"
      msn_list[[j]] <- msn}}
  
  # Combine MSnSets with common features
  comp_list <- MSnbase::commonFeatureNames(msn_list)
  
  # Store in overall list with dataset name
  all_comp_lists[[df_name]] <- comp_list}

# Bandle
# Map of timepoint names
tp_map <- c("1hr" = "hr1", "4hr" = "hr4", "16hr" = "hr16", "24hr" = "hr24")
bandle_results <- list()

apply_predictions <- function(obj) {
  obj <- getPredictions(obj, fcol = "bandle.allocation", scol = "bandle.probability", mcol = "markers", t = 0.95)
  fData(obj)$bandle.outlier.t <- 1 - fData(obj)$bandle.outlier
  obj <- getPredictions(obj, fcol = "bandle.allocation.pred", scol = "bandle.outlier.t", mcol = "markers", t = 0.95)
  obj <- getPredictions(obj, fcol = "bandle.allocation.pred.pred", scol = "bandle.outlier.t", mcol = "markers", t = 0.95)
  return(obj)}

for (tp in names(all_comp_lists)) {
  cat("\nProcessing timepoint:", tp, "\n")
  
  mapped_tp <- tp_map[[tp]]
  comp_list <- all_comp_lists[[tp]]
  
  control_full <- comp_list[[1]]
  thaps_full <- comp_list[[2]]
  
  #find features in training data
  trained_feats <- rownames(bandleres[[mapped_tp]]@summary@summaries[[1]]@posteriorEstimates)
  
  #find marker rows in each dataset
  marker_rows_ctrl <- rownames(control_full)[!rownames(control_full) %in% trained_feats & !is.na(fData(control_full)$markers)]
  marker_rows_thps <- rownames(thaps_full)[!rownames(thaps_full) %in% trained_feats & !is.na(fData(thaps_full)$markers)]

  #filter datasets to include markers and proteins in both control and thapsigargin
  final_feats_ctrl <- intersect(rownames(control_full), unique(c(trained_feats, marker_rows_ctrl)))
  final_feats_thps <- intersect(rownames(thaps_full), unique(c(trained_feats, marker_rows_thps)))
  final_feats <- intersect(final_feats_ctrl, final_feats_thps)
  
  # Reorder so training features come first in the correct order
  final_feats_ordered <- c(
    trained_feats[trained_feats %in% final_feats],
    setdiff(final_feats, trained_feats))
  
  # assign control and thapsigargin
  control_trained <- list(control_full[final_feats_ordered, ])
  thapsigargin_trained <- list(thaps_full[final_feats_ordered, ])
  
  # Check for mismatches BEFORE calling bandlePredict
  if (!identical(rownames(control_trained[[1]]), rownames(thapsigargin_trained[[1]]))) {
    ctrl_only <- setdiff(rownames(control_trained[[1]]), rownames(thapsigargin_trained[[1]]))
    thps_only <- setdiff(rownames(thapsigargin_trained[[1]]), rownames(control_trained[[1]]))
    
    warning(paste0("❌ Feature name mismatch at ", tp, ":\n",
                   "- Present in control only: ", paste(ctrl_only, collapse = ", "), "\n",
                   "- Present in thapsigargin only: ", paste(thps_only, collapse = ", ")))
    next
  }
  
  # Attempt prediction, capture any error
  xx <- tryCatch({
    bandlePredict(control_trained, thapsigargin_trained, 
                  params = bandleres[[mapped_tp]], fcol = "markers")
  }, error = function(e) {
    message("❌ Error during bandlePredict() at timepoint ", tp, ":\n", e$message)
    return(NULL)
  })
  
  # Skip if bandlePredict failed
  if (is.null(xx)) next

  res_ctrl <- xx[[1]]
  res_thps <- xx[[2]]

  res_ctrl[[1]] <- apply_predictions(res_ctrl[[1]])
  res_thps[[1]] <- apply_predictions(res_thps[[1]])

  # Merge predictions back into full MSnSet
  fData(control_full)[rownames(res_ctrl[[1]]), colnames(fData(res_ctrl[[1]]))] <- fData(res_ctrl[[1]])
  fData(thaps_full)[rownames(res_thps[[1]]), colnames(fData(res_thps[[1]]))] <- fData(res_thps[[1]])

  # Store results
  bandle_results[[tp]] <- list(
    control_full = control_full,
    thps_full = thaps_full)}

