    mirror_ctrl_y <- TRUE
    mirror_ctrl_x <- TRUE
  }

  # Plot control
  plot2D(res_ctrl, fcol = "bandle.allocation.pred.pred",
         mirrorX = mirror_ctrl_x, mirrorY = mirror_ctrl_y) +
    title(main = paste("Control -", tp))

  # Plot thapsigargin
  plot2D(res_thps, fcol = "bandle.allocation.pred.pred",
         mirrorX = mirror_thps_x, mirrorY = mirror_thps_y) +
    title(main = paste("Thapsigargin -", tp))
}

