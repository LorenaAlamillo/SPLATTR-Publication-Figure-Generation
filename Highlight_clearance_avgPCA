# Average signal for each fraction between reps
averages_by_time_fraction <- function(df, id_col = "rowname") {
  # Store and remove the ID column
  ids <- df[[id_col]]
  df_numeric <- df[, !(names(df) == id_col)]
  df_numeric[df_numeric < 1e-15] <- NA #filter out small values

# Separate column names into C and T conditions
  c_cols <- grep("^C", names(df_numeric), value = TRUE)
  t_cols <- grep("^T", names(df_numeric), value = TRUE)
  
  # Helper to group and average by suffix
  average_condition <- function(cols) {
    suffixes <- sub("^[^_]*", "", cols)
    groups <- split(cols, suffixes)
    averaged <- sapply(groups, function(g) {
    vals <- df_numeric[, g, drop = FALSE]
    avg <- rowMeans(vals, na.rm = TRUE)
    avg[rowSums(!is.na(vals)) < 3] <- NA
    avg})
    return(as.data.frame(averaged))}
  
  c_avg <- average_condition(c_cols)
  t_avg <- average_condition(t_cols)
  
  # Rename columns to indicate condition
  colnames(c_avg) <- paste0("C", colnames(c_avg))
  colnames(t_avg) <- paste0("T", colnames(t_avg))
  
  # Combine with ID column
  result <- cbind(df[id_col], c_avg, t_avg)
  return(result)}

averages <- averages_by_time_fraction(combination)

# Pull each condition into its own dataframe 
split_averaged_by_condition <- function(df, id_col = "rowname") {
  # Extract column names (excluding the ID column)
  data_cols <- setdiff(names(df), id_col)

  # Extract condition names from colnames without fraction
  condition_keys <- sub("^[^_]*_([^_]*).*", "\\1", data_cols)

  # Group columns by the condition
  condition_groups <- split(data_cols, condition_keys)
  
  # For each condition, make a new data frame with the ID column and the matching C/T columns
  result_list <- lapply(condition_groups, function(cols) {
    df_subset <- df[, c(id_col, cols), drop = FALSE]
    return(df_subset)})
  
  return(result_list)}
averages_list <- split_averaged_by_condition(averages)

