pick_deviation <- pick_deviation[consistent_order]

# Combine the means into a single data frame
mean_df <- data.frame(
  DataFrame = rep(c("control_mean", "spin_mean", "pick_mean"), each = length(consistent_order)),
  Group = rep(c("control", "spin", "pick"), each = length(consistent_order)),
  Column = rep(consistent_order, times = 3),
  Mean = c(as.numeric(control_mean), as.numeric(spin_mean), as.numeric(pick_mean)))

stdev_df <- data.frame(
  DataFrame = rep(c("control_deviation", "spin_deviation", "pick_deviation"), each = length(consistent_order)),
  Group = rep(c("control", "spin", "pick"), each = length(consistent_order)),
  Column = rep(consistent_order, times = 3),
  Stdev = c(as.numeric(control_deviation), as.numeric(spin_deviation), as.numeric(pick_deviation)))

plot_df <- mean_df %>%
  left_join(stdev_df, by = c("Column", "Group"))

pdf(file=file.path("../Figs", "QSEP_distances_by_organelle.pdf"), height=9, width=12, useDingbats = F)
#plot the averages for each organelle of each method on a plot
# Define colors for each organelle
organelle_colors <- c(
  "ER" = "steelblue",
  "GA" = "seagreen",
  "PM" = "pink1",
  "NUCLEUS" = "turquoise2",
  "MITOCHONDRION" = "yellow2",
  "LYSOSOME" = "orange2",
  "CYTOSOL" = "red3",
  "RIBOSOME" = "yellowgreen",
  "PROTEASOME" = "mediumorchid4",
  "xCYTOSKELETON" = "midnightblue",
  "xCHROMATIN" = "lightsteelblue",
  "PEROXISOME" = "burlywood4")

# Plot the data using ggplot2 with custom colors
ggplot(plot_df, aes(x = Column, y = Mean, fill = Column)) +
  geom_bar(stat = "identity", position = "dodge", width = 0.7) +
  geom_errorbar(aes(ymin = Mean - Stdev, ymax = Mean + Stdev),
              width = 0.2, position = position_dodge(0.7)) +
  facet_wrap(~ factor(DataFrame.x, levels = c("control_mean", "spin_mean", "pick_mean"))) +
  labs(title = "Column Means of Multiple Data Frames", x = "Organelle", y = "Mean") +
  scale_fill_manual(values = organelle_colors) +  # Assign colors to each organelle
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  theme(plot.title = element_text(hjust = 0.5)) +
  scale_y_continuous(expand = c(0, 0) ) +
  guides(fill = FALSE)

