
library(tidyverse)
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpointdensity)
library(wesanderson)
library(ggrepel)
library(ggthemes)

# Download data
light <- readr::read_tsv(file.path("/Volumes/Omics-Shared/Lorena/SPLATTR_QEHF/20241010_LA4SPLAT_AC16CtrlThps4hr24hrR3/processed", "51c_limma_Light.tsv"))
heavy <- readr::read_tsv(file.path("/Volumes/Omics-Shared/Lorena/SPLATTR_QEHF/20241010_LA4SPLAT_AC16CtrlThps4hr24hrR3/processed", "51b_limma_Heavy.tsv"))
allocations <- readr::read_tsv(file.path("/Volumes/Omics-Shared/Lorena/SPLATTR_QEHF/20241010_LA4SPLAT_AC16CtrlThps4hr24hrR3/processed", "50_24hrR1_Ctrl_localization.txt"))

# Extract ER proteins 
# Get ER proteins in list
ER_proteins <- allocations %>% filter(bandle.allocation.pred.pred == "ER")
ER_list <- ER_proteins$rowname

# Get ER light and heavy 
ER_light <- light[light$Entry %in% ER_list, ]
heavy$Entry <- paste0(heavy$Entry, "_H") #add _H to heavy proteins so they match to allocations
ER_heavy <- heavy[heavy$Entry %in% ER_list, ]

# Proteins to label
highlight_death <- c("TMEM214", "ERO1A")
highlight_survival <- c("ERLIN1", "ERLIN2", "TOR1AIP2", "MCFD2", "FDFT1", "SCD")
highlight_autophagy <- c("RPN1", "SEC24D", "TMED9", "UFL1", "CDK5RAP3")
highlight_proteins <- c(highlight_death, highlight_survival, highlight_autophagy)

# Label light
# Get unique timepoints
timepoints <- unique(ER_light$condition)
# Loop through each timepoint
for (tp in timepoints) {
  df_tp <- ER_light[ER_light$condition == tp, ]
  
  # Add a color column for the highlighted proteins
  df_tp$label_color <- NA
  df_tp$label_color[df_tp$GN %in% highlight_death] <- "firebrick"
  df_tp$label_color[df_tp$GN %in% highlight_survival] <- "darkturquoise"
  df_tp$label_color[df_tp$GN %in% highlight_autophagy] <- "purple"
  
  g <- ggplot(data = df_tp, aes(x = logFC, y = -log10(P.Value))) +
    geom_point(color = "#4783B5", alpha = 0.6) +
    ggthemes::theme_few() +
    theme(aspect.ratio = 1) +
    geom_text_repel(
      data = subset(df_tp, GN %in% highlight_proteins),
     aes(label = GN, color = I(label_color)),  # use I() to use actual colors
     size = 2, 
     force = 0.15, 
     point.padding = 0, 
     box.padding = 0
      ) +
    coord_cartesian(xlim = c(-2.4, 2.4), ylim = c(0, 10)) +
    geom_vline(xintercept = 0) +
    ggtitle(paste(tp)) +
    xlab("Log2 Fold Change") +
    stat_function(fun = function(x) (-log10(0.05) + (log(1.2) / x)^2), 
                  lty = 2, n = 1500, xlim = c(-11, 11), linewidth = 0.2, alpha = 1)
  
  ggsave(plot = g,
         filename = paste0("../figs/22v2_lightER_", tp, "_volcano.pdf"),
         width = 5, height = 5, useDingbats = FALSE)}

