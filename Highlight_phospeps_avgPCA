for (hr in names(merged_data)) {

  expr <- merged_data[[hr]]$T

  # PCA
  pca_result <- prcomp(expr, scale. = TRUE)

  # mirror selected timepoints
  if (hr %in% c("hr1")) {
    pca_result$x[, 1] <- -pca_result$x[, 1]
    pca_result$x[, 2] <- -pca_result$x[, 2]}

  if (hr %in% c("hr4")) {
    pca_result$x[, 2] <- -pca_result$x[, 2]}
  
    if (hr %in% c("hr16")) {
    pca_result$x[, 1] <- -pca_result$x[, 1]}

  # metadata
  meta <- merged_allocations_thps[[hr]]
  rownames(meta) <- meta$rowname

  # Keep only shared rows
  common <- intersect(rownames(pca_result$x), rownames(meta))

  df_plot <- data.frame(pca_result$x[common, 1:2])
  df_plot$allocation <- meta[common, "allocation"]

  # add protein IDs
  df_plot$protein <- rownames(df_plot)
  df_plot$label <- label_map[df_plot$protein]

  # highlight flag
  df_plot$highlight <- ifelse(df_plot$protein %in% highlight_proteins,
                              "highlight", "normal")

  # base plot (all proteins colored by allocation)
  p <- ggplot(df_plot, aes(PC1, PC2)) +

    geom_point(aes(color = allocation, size = allocation), alpha = 0.7) +

    # highlight overlay
    geom_point(
      data = subset(df_plot, highlight == "highlight"),
      aes(PC1, PC2),
      color = "black",
      size = 3,
      shape = 3,
      stroke = 1.2) +
    
    geom_text_repel(
      data = subset(df_plot, highlight == "highlight" & !is.na(label)),
      aes(PC1, PC2, label = label),
      size = 3,
      color = "black",
      max.overlaps = Inf) +

    scale_size_manual(values = c(
      "unknown" = 1.5,
      "phos" = 0.8,
      "ER" = 1.8,
      "GA" = 1.8,
      "PM" = 1.8,
      "Cytosol" = 1.8,
      "Nucleus" = 1.8,
      "Mito/Chrom" = 1.8,
      "Lysosome" = 1.8,
      "Peroxisome" = 1.8,
      "Proteasome" = 1.8,
      "Ribosome" = 1.8)) +

    scale_color_manual(values = alloc_colors) +
    theme_minimal() +
    labs(title = paste("PCA T -", hr))

  pca_plots[[hr]] <- p}

