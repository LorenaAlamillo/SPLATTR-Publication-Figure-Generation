# Get nonphos MSNs with bandle
bandles <- list(
  hr1 = readRDS(file=file.path("../processed", "14_avgmsn_bandle_1hr.Rds")),
  hr4 = readRDS(file=file.path("../processed", "14_avgmsn_bandle_4hr.Rds")),
  hr16 = readRDS(file=file.path("../processed", "14_avgmsn_bandle_16hr.Rds")),
  hr24 = readRDS(file=file.path("../processed", "14_avgmsn_bandle_24hr.Rds")))

# Get phos MSN
phosMSN <- list(
  hr1 = readRDS(file=file.path("../processed", "45_phos_avgmsn_1hr.Rds")),
  hr4 = readRDS(file=file.path("../processed", "45_phos_avgmsn_4hr.Rds")),
  hr16 = readRDS(file=file.path("../processed", "45_phos_avgmsn_16hr.Rds")),
  hr24 = readRDS(file=file.path("../processed", "45_phos_avgmsn_24hr.Rds")))

# Get dataframes
# For nonphos
nonphos <- lapply(names(bandles), function(hr) {
  control_df <- as.data.frame(exprs(bandles[[hr]]$control_full))
  thps_df    <- as.data.frame(exprs(bandles[[hr]]$thps_full))
  thps_df <- rownames_to_column(thps_df, var = "rowname")
  control_df <- rownames_to_column(control_df, var = "rowname")
  
  list(
    control = control_df,
    thps    = thps_df)})

names(nonphos) <- names(bandles)

# For phos
phospeps <- lapply(names(phosMSN), function(hr) {

  obj <- phosMSN[[hr]]@x
  # Extract all conditions inside hr
  cond_names <- names(obj)
  cond_list <- lapply(cond_names, function(cond) {
    df <- as.data.frame(exprs(obj[[cond]]))
    df <- rownames_to_column(df, var = "rowname")})

names(cond_list) <- cond_names})
names(phospeps) <- names(phosMSN)

# Make list of allocations with rownames
allocations_list <- list()
for (hr in names(bandles)) {
  ctrl <- bandles[[hr]]$control_full
  thps <- bandles[[hr]]$thps_full
  allocations_list[[hr]] <- list(
    control = data.frame(
      rowname = rownames(ctrl),
      allocation = fData(ctrl)$bandle.allocation.pred.pred),

    thps = data.frame(
      rowname = rownames(thps),
      allocation = fData(thps)$bandle.allocation.pred.pred))}

# Get rownames for phos
phos_proteins <- list()
for (hr in names(phospeps)) {
  obj <- phospeps[[hr]]
  ctrl_name <- grep("^C_", names(obj), value = TRUE)
  df <- obj[[ctrl_name]]
  phos_proteins[[hr]] <- data.frame(
    rowname = df[[1]],   # adjust if needed
    allocation = "phos")}

# Bind dataframes
merged_allocations_ctrl <- list()
for (hr in names(allocations_list)) {
  merged_allocations_ctrl[[hr]] <- dplyr::bind_rows(
    allocations_list[[hr]]$control,
    phos_proteins[[hr]])}
merged_allocations_thps <- list()
for (hr in names(allocations_list)) {
  merged_allocations_thps[[hr]] <- dplyr::bind_rows(
    allocations_list[[hr]]$thps,
    phos_proteins[[hr]])}

merged_data <- list()
for (hr in names(nonphos)) {
  # -------------------------
  # NONPHOS
  # -------------------------
  nonphos_C <- nonphos[[hr]]$control
  nonphos_T <- nonphos[[hr]]$thps
  # -------------------------
  # PHOS (pattern matched)
  # -------------------------
  phos_obj <- phospeps[[hr]]
  phos_C <- phos_obj[[grep("^C_", names(phos_obj), value = TRUE)[1]]]
  phos_T <- phos_obj[[grep("^T_", names(phos_obj), value = TRUE)[1]]]
  # -------------------------
  # BIND WITHIN CONDITION
  # -------------------------
  merged_data[[hr]] <- list(
    C = dplyr::bind_rows(nonphos_C, phos_C),
    T = dplyr::bind_rows(nonphos_T, phos_T))}

# Make first column rownames
merged_data <- lapply(merged_data, function(hr_list) {

  for (cond in c("C", "T")) {

    hr_list[[cond]] <- tibble::column_to_rownames(
      hr_list[[cond]],
      var = "rowname")}})

