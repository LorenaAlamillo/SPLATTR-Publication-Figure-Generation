pca_plots <- list()

highlight_proteins <- c("P27824_S564", "P43307_S284", "Q9H3N1_S247", "P27824", "P43307", "Q9H3N1")

label_map <- c(
  "P27824_S564" = "CANX_S564",
  "P43307_S284" = "SSR1_S284",
  "Q9H3N1_S247" = "TMX1_S247",
